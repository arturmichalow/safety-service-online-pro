generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WORKER
}

enum CompanyStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum BillingType {
  MONTHLY
  ONE_TIME
  HOURLY
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  name              String
  passwordHash      String
  role              Role        @default(WORKER)
  active            Boolean     @default(true)
  permissions       Json?
  workEntries       WorkEntry[]
  quickNotes        QuickNote[]
  auditLogs         AuditLog[]
  assignedCompanies Company[]
  createdAt         DateTime    @default(now())
}

model Company {
  id                   String        @id @default(cuid())
  name                 String
  nip                  String?
  address              String?
  contactPerson        String?
  phone                String?
  email                String?
  serviceType          String?
  status               CompanyStatus @default(ACTIVE)
  orderNumber          String?
  netAmount            Decimal       @default(0)
  billingType          BillingType   @default(MONTHLY)
  travelCost           Decimal       @default(0)
  extraCost            Decimal       @default(0)
  extraCostDescription String?
  latitude             Float?
  longitude            Float?
  regon                 String?
  krs                   String?
  dataSource            String?
  geocodedAt            DateTime?
  assignedUserId       String?
  assignedUser         User?         @relation(fields: [assignedUserId], references: [id])
  workEntries          WorkEntry[]
  extraOrders          ExtraOrder[]
  quickNotes           QuickNote[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model WorkEntry {
  id                        String   @id @default(cuid())
  date                      DateTime
  companyId                 String
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                    String
  user                      User     @relation(fields: [userId], references: [id])
  orderNumber               String?
  type                      String
  title                     String
  description               String?
  minutes                   Int
  travelMinutes             Int      @default(0)
  additionalCost            Decimal  @default(0)
  additionalCostDescription String?
  notes                     String?
  createdAt                 DateTime @default(now())
}

model QuickNote {
  id          String   @id @default(cuid())
  content     String
  status      String   @default("OPEN")

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  workEntryId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([status])
}
model ExtraOrder {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date                 DateTime @default(now())
  title                String
  type                 String
  description          String?
  netAmount            Decimal  @default(0)
  travelCost           Decimal  @default(0)
  extraCost            Decimal  @default(0)
  minutes              Int      @default(0)
  extraCostDescription String?
  orderNumber          String?
  status               String   @default("OPEN")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
